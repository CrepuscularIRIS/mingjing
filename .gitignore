# --- Secrets & local runtime state (NEVER commit) ---
.env
.env.*
!.env.example

# --- Python ---
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
src/*.egg-info/

# --- Node / frontend ---
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/

# --- SQLite runtime stores (demo/live data; not source) ---
data/*.db
data/**/*.db
data/cache/

# --- Misc ---
*.log
.DS_Store
