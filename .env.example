# MingJing environment template — copy to `.env` (gitignored) and fill in real values.
# NEVER commit a populated .env. All secrets are read from the environment at runtime.

# --- LLM provider (MiniMax, OpenAI-compatible) ---
# API key for the MiniMax OpenAI-compatible endpoint. Required for live runs.
# Leave unset to force the deterministic fake provider (offline/CI).
MINIMAX_API_KEY=your-minimax-api-key-here
# Chat/reasoning model id.
MINIMAX_MODEL=MiniMax-M2.7
# OpenAI-compatible base URL. Default is the MiniMax /v1 host (NOT the /anthropic variant).
MINGJING_LLM_BASE_URL=https://api.minimaxi.com/v1

# --- Runtime knobs (all optional; defaults shown) ---
# Run mode: "live_first" (real web + LLM) or "cache_first" (deterministic fallback for demos/offline).
MINGJING_MODE=live_first
# Hard ceiling on LLM calls per run (budget guard).
MINGJING_BUDGET_CALLS=40
# Max QA revision rounds before honest partial.
MINGJING_REVISE_CAP=2
# Per-field source cap baseline (grows by revision round for honest weak->strong re-fetch).
MINGJING_SOURCE_CAP=3
# Per-fetch timeout in seconds before transparent cache fallback.
MINGJING_FETCH_TIMEOUT=20
# Enable the adaptive rate limiter ("1"/"true" to enable). MUST be set for live demos.
MINGJING_RATE_LIMITING_ENABLED=1
# SQLite store paths (defaults live under the project data dir).
MINGJING_DB=data/mingjing.db
MINGJING_CACHE_DB=data/cache/cache.db

# --- Web search ---
# The live collector (deep-collect path) runs ALL keyed engines in the active
# depth tier concurrently and merges results; an engine with no key/URL just
# returns [] and drops out. Set at least one reachable from your demo network.
# From a CHINA network, prefer Bocha + self-hosted SearXNG (CN backends);
# foreign engines (Tavily/Brave/DDG) are throttled or blocked there.
#
# 博查 Bocha — China-reachable AI search (recommended primary in CN). https://open.bochaai.com/
BOCHA_API_KEY=
# Tavily — foreign agent-grade search, free 1000/mo (best when demo is overseas/VPN).
TAVILY_API_KEY=
# Brave Search API — foreign, free 2000/mo (optional, used only in the "detailed" tier).
BRAVE_API_KEY=
# Self-hosted SearXNG (keyless local aggregator). Bring up:
#   cd deploy/searxng && docker compose up -d   → MINGJING_SEARXNG_URL=http://localhost:8888
# Or reuse your LDR SearXNG (expose its host port first) — see docs/SEARCH.md.
MINGJING_SEARXNG_URL=

# Legacy single-query chain selector (used only by the non-deep search() helper):
# "auto" (SearXNG if URL set, else DDG), or explicit e.g. "searxng,duckduckgo".
MINGJING_SEARCH_PROVIDER=auto

# --- Optional: LangSmith tracing (endorsement layer; unset = no-op, no import) ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=mingjing
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # only for the EU region
